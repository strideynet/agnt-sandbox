# SSH Key Secret for DevOops Agent
#
# This secret stores the agent's SSH keypair for authenticating to SSH servers.
#
# To create the secret:
#
# 1. Generate an ED25519 keypair:
#    ssh-keygen -t ed25519 -f id_ed25519 -N '' -C 'devoops-agent'
#
# 2. Create the secret from the generated files:
#    kubectl create secret generic devoops-ssh-keys \
#      --from-file=id_ed25519 \
#      --from-file=id_ed25519.pub \
#      -n devoops
#
# 3. Add the public key (id_ed25519.pub) to ~/.ssh/authorized_keys on target servers
#
# 4. The public key is also available in the UI Settings page once the agent starts
#
# Note: Keep the private key secure. Never commit it to version control.
#
# Example manifest (for reference only - use kubectl create secret instead):
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: devoops-ssh-keys
#   namespace: devoops
# type: Opaque
# data:
#   id_ed25519: <base64-encoded-private-key>
#   id_ed25519.pub: <base64-encoded-public-key>
