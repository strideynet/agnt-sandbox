apiVersion: v1
kind: Secret
metadata:
  name: oauth-agent-secret
  namespace: oauth-agent
type: Opaque
stringData:
  # OAuth2 client secret (matches what's configured in Keycloak)
  client-secret: "agent-secret-change-in-production"
  # Session secret for Flask (generate with: python -c "import secrets; print(secrets.token_hex(32))")
  session-secret: "change-this-to-a-random-secret-in-production"
  # Anthropic API key for agent
  anthropic-api-key: "sk-ant-your-api-key-here"
